{
  "name": "teranga-pay",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo Teranga Pay | application mobile Lightning et services de démonstration.",
  "license": "MIT",
  "packageManager": "npm@12.2.1",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=12 <13"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "brand:icons": "node scripts/export-brand-icons.mjs",
    "brand:contrast": "node scripts/export-brand-contrast.mjs",
    "brand:build": "node scripts/build-brand.mjs",
    "brand:document": "node scripts/render-brand-document.mjs",
    "brand:motion": "node scripts/render-brand-motion.mjs",
    "mobile": "npm run start --workspace @teranga-pay/mobile",
    "mobile:provision": "node scripts/provision-mobile.mjs",
    "mobile:android": "npm run android --workspace @teranga-pay/mobile",
    "mobile:ios": "npm run ios --workspace @teranga-pay/mobile",
    "i18n:check": "node scripts/check-mobile-translations.mjs",
    "api": "npm run start --workspace @teranga-pay/api",
    "regtest:up": "docker compose up -d --wait",
    "regtest:seed": "docker compose run --rm seed",
    "regtest:phone": "docker compose run --rm seed node phone.mjs",
    "regtest:integration": "docker compose run --rm seed node integration.mjs",
    "regtest:down": "docker compose down",
    "regtest:reset": "docker compose --profile seed down -v",
    "bridge:setup": "npm run bridge:setup --workspace @teranga-pay/api",
    "bridge:check": "npm run bridge:check --workspace @teranga-pay/api",
    "bridge:demo": "npm run start:bridge --workspace @teranga-pay/api",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace @teranga-pay/bridge-sim && npm run test --workspace @teranga-pay/api && npm run test --workspace @teranga-pay/contracts && npm run test --workspace @teranga-pay/mobile --",
    "test:tooling": "node --test scripts/*.test.mjs scripts/github/*.test.mjs infrastructure/seed/*.test.mjs scripts/release/*.test.mjs",
    "repo:check": "node scripts/check-repository.mjs && node scripts/check-mobile-translations.mjs",
    "prepare": "husky",
    "mobile:web": "npm run web --workspace @teranga-pay/mobile --",
    "e2e:install": "node scripts/install-maestro.mjs",
    "e2e:check": "node scripts/mobile-e2e.mjs check",
    "e2e:build:android": "node scripts/build-mobile-e2e.mjs",
    "e2e:android": "node scripts/mobile-e2e.mjs android"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "markdown-it": "15.0.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
