{
  "name": "@teranga-pay/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "bridge:setup": "node src/setup-bridge.ts",
    "bridge:check": "node --env-file-if-exists=.env --env-file=.env.bridge-sim src/demo-bridge.ts",
    "start:bridge": "node --env-file-if-exists=.env --env-file=.env.bridge-sim src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@teranga-pay/bridge-sim": "0.0.0",
    "@fastify/ajv-compiler": "4.0.7",
    "@fastify/rate-limit": "11.2.2",
    "fastify": "5.12.8"
  }
}
