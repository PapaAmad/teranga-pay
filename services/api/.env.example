# Exemple neutre pour l'API Teranga. Copier en .env (ignoré par Git) si besoin.
API_HOST=127.0.0.1
API_PORT=3000
API_LOG_LEVEL=info
API_RATE_LIMIT_MAX=60
API_RATE_LIMIT_WINDOW_MS=60000
RATE_SOURCE=fixe
RATE_FIXED_XOF_PER_BTC=45000000
QUOTE_TTL_SECONDS=300
LNADDRESS_DOMAIN=teranga.example
PUBLIC_BASE_URL=http://127.0.0.1:3000
LNURL_CALLBACK_TIMEOUT_MS=15000
# T34 : fichier JSON qui remplace les hypothèses d'économies (voir README). Vide = hypothèses par défaut.
SAVINGS_ASSUMPTIONS_FILE=
# T23 | Retraits entièrement fictifs, désactivés par défaut.
# Préparer .env.bridge-sim avec npm run bridge:setup, sans afficher son jeton.
BRIDGE_SIM_ENABLED=false
BRIDGE_SIM_TOKEN=
BRIDGE_SIM_DB_PATH=.data/bridge-sim.sqlite
BRIDGE_SIM_SCENARIO=success
